# ---------------------------------------------------------------------------
# Head node: slurmctld + slurmdbd + MariaDB
# ---------------------------------------------------------------------------
log "Installing controller packages"
dnf install -y slurm-slurmctld slurm-slurmdbd mariadb-server

log "Writing Slurm configuration"
echo "${slurm_conf}" | base64 -d > /etc/slurm/slurm.conf
echo "${cgroup_conf}" | base64 -d > /etc/slurm/cgroup.conf
echo "${gres_conf}" | base64 -d > /etc/slurm/gres.conf
chmod 0644 /etc/slurm/slurm.conf /etc/slurm/cgroup.conf /etc/slurm/gres.conf

log "Generating the MUNGE key and publishing it to SSM Parameter Store"
umask 077
dd if=/dev/urandom bs=1 count=1024 of=/etc/munge/munge.key status=none
chown munge:munge /etc/munge/munge.key
chmod 0400 /etc/munge/munge.key
base64 -w0 /etc/munge/munge.key > /root/munge.b64
aws ssm put-parameter --region "$REGION" --name "$MUNGE_PARAM" --type SecureString \
  --key-id "$KMS_KEY_ARN" --overwrite --value "file:///root/munge.b64" >/dev/null
shred -u /root/munge.b64
umask 022
restorecon -R /etc/munge /etc/slurm || true
systemctl enable --now munge

log "MariaDB for job accounting (localhost only, random password)"
cat > /etc/my.cnf.d/slurm.cnf <<'CNF'
[mysqld]
bind-address=127.0.0.1
innodb_buffer_pool_size=512M
innodb_lock_wait_timeout=900
CNF
systemctl enable --now mariadb
DB_PASS="$(openssl rand -hex 24)"
mysql -u root <<SQL
CREATE DATABASE IF NOT EXISTS slurm_acct_db;
CREATE USER IF NOT EXISTS 'slurm'@'localhost' IDENTIFIED BY '$DB_PASS';
ALTER USER 'slurm'@'localhost' IDENTIFIED BY '$DB_PASS';
GRANT ALL PRIVILEGES ON slurm_acct_db.* TO 'slurm'@'localhost';
FLUSH PRIVILEGES;
SQL

install -m 0600 -o slurm -g slurm /dev/null /etc/slurm/slurmdbd.conf
cat > /etc/slurm/slurmdbd.conf <<CONF
AuthType=auth/munge
DbdHost=$NODE_NAME
DbdPort=6819
SlurmUser=slurm
LogFile=/var/log/slurm/slurmdbd.log
PidFile=/run/slurm/slurmdbd.pid
StorageType=accounting_storage/mysql
StorageHost=localhost
StorageLoc=slurm_acct_db
StorageUser=slurm
StoragePass=$DB_PASS
PurgeEventAfter=12months
PurgeJobAfter=12months
PurgeStepAfter=6months
CONF
unset DB_PASS

log "Starting slurmdbd and slurmctld"
systemctl enable --now slurmdbd
for i in $(seq 1 30); do
  sacctmgr -n list cluster >/dev/null 2>&1 && break
  log "waiting for slurmdbd ($i/30)"
  sleep 5
done
systemctl enable --now slurmctld
sleep 10

log "Accounting: default account and user"
sacctmgr -i add cluster "$CLUSTER" >/dev/null 2>&1 || true
sacctmgr -i add account research Description="Default research account" Organization=lab || true
sacctmgr -i add user "$HPC_USER" Account=research DefaultAccount=research || true

log "Home directory and example jobs for $HPC_USER"
mkdir -p "/shared/home/$HPC_USER/examples" /shared/apps
cat > "/shared/home/$HPC_USER/examples/hello.sbatch" <<'JOB'
#!/bin/bash
#SBATCH --job-name=hello
#SBATCH --partition=compute
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=2
#SBATCH --time=00:05:00
#SBATCH --output=hello-%j.out
srun hostname
JOB
chown -R "$HPC_USER:$HPC_USER" "/shared/home/$HPC_USER"
chmod 0700 "/shared/home/$HPC_USER"

log "Head node ready"
touch /var/lib/hpc-bootstrap.done
